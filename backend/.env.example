# ==============================================================================
# Farmora Backend Environment Variables (Vercel & Production)
# ==============================================================================

# ── Environment & Network ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=5001
BASE_URL=https://farmora-ten.vercel.app
CLIENT_URL=*

# ── Database (MongoDB Atlas) ──────────────────────────────────────────────────
# Required: Full MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=farmora

# ── Authentication (JWT) ──────────────────────────────────────────────────────
# Required: Random 32+ character secure secret for signing user tokens
JWT_SECRET=generate_a_random_secure_secret_key_here
JWT_EXPIRES_IN=7d

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
# Required for card checkout / Stripe PaymentIntents
STRIPE_SECRET_KEY=sk_test_or_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_or_live_your_stripe_publishable_key

# ── Media & Image Storage ─────────────────────────────────────────────────────
# Provider options: 'azure', 'cloudinary', 's3', or 'local'
# NOTE: On Vercel (serverless), 'azure' or 'cloudinary' is recommended because
# local filesystem (/tmp) is ephemeral.
STORAGE_PROVIDER=azure
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=/tmp/uploads

# Azure Blob Storage (if STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<storage_account>;AccountKey=<account_key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=famora-uploads
AZURE_STORAGE_ACCOUNT_NAME=<storage_account>
AZURE_STORAGE_ACCOUNT_KEY=<account_key>

# Cloudinary (if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 / Cloudflare R2 (if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

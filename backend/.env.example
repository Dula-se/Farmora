# Server Configuration
PORT=5001
NODE_ENV=development
BASE_URL=http://localhost:5001

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:8081

# JWT Authentication
JWT_SECRET=famora_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# File Upload Configuration
# STORAGE_PROVIDER can be 'azure', 'local', 'cloudinary', or 's3'
STORAGE_PROVIDER=azure
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# Azure Blob Storage Configuration (when STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<your_storage_account>;AccountKey=<your_account_key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=famora-uploads
AZURE_STORAGE_ACCOUNT_NAME=<your_storage_account>
AZURE_STORAGE_ACCOUNT_KEY=<your_account_key>

# Optional: Cloudinary Configuration (if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: AWS S3 / Cloudflare R2 Configuration (if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

# Database Connection (PostgreSQL / Neon / Supabase / MongoDB)
# DATABASE_URL=postgresql://user:password@localhost:5432/famora_db
